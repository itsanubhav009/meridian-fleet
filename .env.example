# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values. Never commit `.env*`.
# ---------------------------------------------------------------------------

# Postgres connection string.
# Local:  postgresql://postgres:postgres@localhost:5432/meridian_fleet
# Neon:   postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meridian_fleet

# Secret used to sign JWTs (HS256). Must be at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# How long an access token stays valid.
JWT_EXPIRES_IN=8h

# Password used for every seeded demo account (see scripts/seed.ts).
SEED_PASSWORD=Password123!

# Fare rules. Amounts are in paise/cents (integer) to avoid float rounding bugs.
FARE_BASE_CENTS=4000
FARE_PER_KM_CENTS=1450
FARE_MINIMUM_CENTS=6000
